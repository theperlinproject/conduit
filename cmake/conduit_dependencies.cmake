if(CONDUIT_WEBGPU AND NOT EMSCRIPTEN)
    set(CONDUIT_WGPU_DIR "" CACHE PATH "wgpu-native install with include/webgpu and lib")
    if(NOT CONDUIT_WGPU_DIR AND CONDUIT_DEPS_DIR AND EXISTS "${CONDUIT_DEPS_DIR}/wgpu")
        set(CONDUIT_WGPU_DIR "${CONDUIT_DEPS_DIR}/wgpu" CACHE PATH "" FORCE)
    endif()
    if(NOT CONDUIT_WGPU_DIR)
        set(wgpu_tag v25.0.2.2)
        string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" wgpu_cpu)
        if(APPLE AND CMAKE_OSX_ARCHITECTURES)
            string(TOLOWER "${CMAKE_OSX_ARCHITECTURES}" wgpu_cpu)
        endif()
        if(ANDROID)
            set(wgpu_cpu "${ANDROID_ABI}")
        endif()
        if(wgpu_cpu MATCHES "aarch64|arm64")
            set(wgpu_arch aarch64)
        elseif(wgpu_cpu MATCHES "armeabi|armv7")
            set(wgpu_arch armv7)
        else()
            set(wgpu_arch x86_64)
        endif()
        if(WIN32)
            if(MSVC OR CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
                set(wgpu_name wgpu-windows-${wgpu_arch}-msvc-release)
            else()
                set(wgpu_name wgpu-windows-${wgpu_arch}-gnu-release)
            endif()
        elseif(APPLE)
            set(wgpu_name wgpu-macos-${wgpu_arch}-release)
        elseif(ANDROID)
            set(wgpu_name wgpu-android-${wgpu_arch}-release)
        else()
            set(wgpu_name wgpu-linux-${wgpu_arch}-release)
        endif()
        FetchContent_Declare(wgpu_native URL https://github.com/gfx-rs/wgpu-native/releases/download/${wgpu_tag}/${wgpu_name}.zip)
        FetchContent_MakeAvailable(wgpu_native)
        set(CONDUIT_WGPU_DIR "${wgpu_native_SOURCE_DIR}" CACHE PATH "" FORCE)
    endif()
    if(WIN32 AND (MSVC OR CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC"))
        find_library(CONDUIT_WGPU_LIB NAMES wgpu_native.dll.lib HINTS "${CONDUIT_WGPU_DIR}/lib" NO_DEFAULT_PATH)
        set(CONDUIT_RUNTIME_DLL "${CONDUIT_WGPU_DIR}/lib/wgpu_native.dll" CACHE FILEPATH "Library to ship beside the executable" FORCE)
    else()
        find_library(CONDUIT_WGPU_LIB NAMES libwgpu_native.a HINTS "${CONDUIT_WGPU_DIR}/lib" NO_DEFAULT_PATH)
    endif()
    if(NOT CONDUIT_WGPU_LIB)
        message(FATAL_ERROR "conduit: wgpu-native library not found under ${CONDUIT_WGPU_DIR}/lib")
    endif()
endif()
