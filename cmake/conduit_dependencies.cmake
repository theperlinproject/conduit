include(FetchContent)

function(conduit_dependency name dir repo tag)
    if(CONDUIT_DEPS_DIR AND EXISTS "${CONDUIT_DEPS_DIR}/${dir}")
        set(FETCHCONTENT_SOURCE_DIR_${name} "${CONDUIT_DEPS_DIR}/${dir}" CACHE PATH "" FORCE)
    endif()
    if("${tag}" MATCHES "^[0-9a-f]+$" AND NOT "${tag}" MATCHES "^[0-9]+$")
        set(shallow FALSE)
    else()
        set(shallow TRUE)
    endif()
    FetchContent_Declare(${name} GIT_REPOSITORY ${repo} GIT_TAG ${tag} GIT_SHALLOW ${shallow} SYSTEM)
    FetchContent_GetProperties(${name})
    if(NOT ${name}_POPULATED)
        FetchContent_Populate(${name})
    endif()
    set(${name}_SOURCE_DIR "${${name}_SOURCE_DIR}" PARENT_SCOPE)
endfunction()

if(CONDUIT_VULKAN)
